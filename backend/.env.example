NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/digiline_tech?schema=public"

# At least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only by `npm run db:seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
