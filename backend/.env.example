NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/digiline_tech?schema=public"

# At least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only by `npm run db:seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: email the admin when a new contact message arrives.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=a Google "App Password" (not your normal password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where notifications go (defaults to SMTP_USER)
NOTIFY_EMAIL=
